{
  "name": "sd-random",
  "version": "0.1.4",
  "description": "SilverDecisions module - Tools for generating random numbers from various distributions",
  "main": "index.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && rollup -c",
    "test": "node --test \"test/**/*.test.js\"",
    "test:build": "node scripts/check-build.js",
    "docs": "documentation build index.js -f md -o doc/API.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverDecisions/sd-random.git"
  },
  "keywords": [
    "SilverDecisions",
    "random",
    "distributions"
  ],
  "author": "Przemysław Szufel, Michał Wasiluk",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/SilverDecisions/sd-random/issues"
  },
  "homepage": "https://github.com/SilverDecisions/sd-random#readme",
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ]
        }
      ]
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "acorn": "^8.19.0",
    "documentation": "^14.0.3",
    "rollup": "^4.67.2"
  }
}
